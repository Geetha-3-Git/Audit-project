# Copy this file to .env and restart `npm run dev`
# Data source: sample (built-in data) | local (public/faqs.xlsx) | onedrive (browser login) | api (Spring Boot backend)
VITE_DATA_SOURCE=sample

# OneDrive settings (from your Azure / Microsoft Entra app registration)
VITE_MSAL_CLIENT_ID=
# Work account: your Tenant ID. Personal account: common
VITE_MSAL_TENANT_ID=common

# File path inside your OneDrive (from the root)
VITE_ONEDRIVE_PATH=AuditHub/faqs.xlsx

# Only if the file is shared from someone else's OneDrive (leave empty otherwise)
VITE_ONEDRIVE_DRIVE_ID=
VITE_ONEDRIVE_ITEM_ID=
